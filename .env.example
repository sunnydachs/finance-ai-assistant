# Copy to .env and fill in. NEVER commit the real .env.
# Anthropic Messages API endpoint. The default points to the OpenRouter
# gateway (Anthropic-compatible). To use first-party Anthropic, replace the
# URL/token below and set APP_MODEL / JUDGE_MODEL to anthropic/* model IDs.
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-xxxx

# Model IDs (gateway-prefixed)
APP_MODEL=inclusionai/ling-3.0-flash-fin:free
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
